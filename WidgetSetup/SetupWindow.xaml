<Window x:Class="WidgetSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du widget"
        Width="560"
        Height="390"
        MinWidth="500"
        MinHeight="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E4FB6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#14213D" />
            <Setter Property="Background" Value="#EEF2F8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DCE5F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="9"
            Background="#F5F8FAFC"
            CornerRadius="19"
            BorderBrush="#B8FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="3"
                              Opacity="0.2"
                              Color="#14213D" />
        </Border.Effect>

        <Grid Margin="24,19,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Gestion du widget"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#14213D" />
                    <TextBlock Text="Installation et réparation en un seul endroit"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#6B7280" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        Style="{StaticResource QuietButton}"
                        Padding="8,3"
                        FontSize="20"
                        Click="CloseButton_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="2,20,2,0"
                       Text="Ce programme installe la dernière version du widget sans demander le SDK .NET."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#374151" />

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="14"
                    Background="#DCEFF2F5"
                    CornerRadius="13"
                    BorderBrush="#8FFFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="État"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#14213D" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#374151" />
                    <ProgressBar x:Name="ProgressBar"
                                 Margin="0,10,0,0"
                                 Height="5"
                                 Visibility="Collapsed"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       x:Name="HelpText"
                       Margin="3,16,3,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#6B7280" />

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Annuler"
                        Style="{StaticResource QuietButton}"
                        Click="CloseButton_Click" />
                <Button x:Name="ActionButton"
                        Content="Installer / réparer le widget"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="ActionButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
